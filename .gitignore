# API keys — never commit these
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Cached model responses
.cache/

# The live request log (capstone). serve.py appends to logs/requests.jsonl, so
# committing it hands every fresh clone someone else's history. The committed
# run record lives in results/run_record_capstone.jsonl instead.
logs/

# OS noise
.DS_Store
Thumbs.db

# NOTE: results/ is deliberately NOT ignored. Your run logs are evidence that
# the test actually happened, and they're part of what gets graded. Commit them.
